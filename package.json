{
  "name": "bounty-truth-check",
  "version": "0.1.0",
  "private": true,
  "description": "Open agentic website: four browser-run agents check whether a paid-task listing is real, open and safe.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node tools/build_network.mjs site/bounty_truth_check.hocon --manifest site/agent-manifest.json --runtime site/runtime",
    "check:network": "node tools/build_network.mjs site/bounty_truth_check.hocon --manifest site/agent-manifest.json --runtime site/runtime --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1 --directory site"
  }
}
